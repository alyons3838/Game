{
  "name": "the-long-road-home",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A post-apocalyptic branching narrative RPG that runs on mobile, desktop, and TV browsers",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:content": "tsx scripts/validate-content.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
