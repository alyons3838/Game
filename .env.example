# Optional. Points the game at a deployed AI character-generation proxy.
# Leave unset and the game builds characters locally — which is the default and
# needs no key, no network, and no configuration.
#
# See server/generate-character.ts for the proxy. The Anthropic API key lives
# there, never here — anything with a VITE_ prefix is compiled into the bundle
# and is public.
VITE_AI_ENDPOINT=
